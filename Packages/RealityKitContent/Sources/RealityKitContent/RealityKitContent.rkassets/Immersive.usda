#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["Sphere_Left", "Sphere_Right", "GridMaterial"]
    def "Stright__1_" (
        active = true
        customData = {
            float3 rotationEulerHint = (-9.07571, 3.1415927, -3.1415925)
        }
        prepend references = @Stright (1).usdz@
    )
    {
        quatf xformOp:orient = (0.9848076, 0.17364907, -2.993717e-8, 8.194135e-8)
        float3 xformOp:scale = (0.1, 0.1, 0.1)
        float3 xformOp:translate = (0, 0.08630684, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "_materials"
        {
            over "LowPoly"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex
            }
        }
    }
}

